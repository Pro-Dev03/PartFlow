{
  "appId": "com.partflow.desktop",
  "productName": "PartFlow",
  "artifactName": "PartFlow-${version}-${arch}.${ext}",
  "directories": {
    "output": "dist-electron-internal",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../dist/windows-release/partflow-api.exe",
      "to": "backend/partflow-api.exe"
    },
    {
      "from": "../backend/partflow-local.db",
      "to": "partflow.db"
    }
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker",
    "signAndEditExecutable": true,
    "signtoolOptions": {
      "certificateSubjectName": "PartFlow Internal Code Signing"
    },
    "forceCodeSigning": true
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "shortcutName": "PartFlow",
    "artifactName": "PartFlow-${version}-setup.exe"
  },
  "portable": {
    "artifactName": "PartFlow-${version}-portable.exe"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "build/icon.png",
    "category": "Office"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "build/icon.icns"
  }
}
