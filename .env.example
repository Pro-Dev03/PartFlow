# Database connection selection
# Supported modes: default, local, cloud, auto
DB_CONNECTION_MODE=default
DATABASE_URL=postgresql://postgres:password@db-host:5432/postgres?sslmode=require
DATABASE_URL_LOCAL=postgres://postgres:postgres@localhost:5432/partflow
DATABASE_URL_CLOUD=postgres://user:password@cloud-host:5432/partflow

# In-process API protection (enabled by default)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=10

# Optional aliases for compatibility
DB_LOCAL_URL=postgres://postgres:postgres@localhost:5432/partflow
DB_CLOUD_URL=postgres://user:password@cloud-host:5432/partflow

SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-key

# JWT
JWT_SECRET=QoUxF7BdQkOS8yzKLVmdgfSCFwSjriN3nnHSNV4IwAd
JWT_ACCESS_TOKEN_TTL=24h
JWT_REFRESH_TOKEN_TTL=30d

# Redis
REDIS_URL=redis://localhost:6379

# Application
APP_NAME=PartFlow
APP_ENV=development
APP_PORT=8080
FRONTEND_URL=http://localhost:3000

# Frontend API connection selection
VITE_API_CONNECTION_MODE=default
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_BASE_URL_LOCAL=http://localhost:8080/api/v1
VITE_API_BASE_URL_CLOUD=https://your-cloud-api.example.com/api/v1

# Backward compatibility aliases
VITE_API_URL=http://localhost:8080

# Supabase
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email
SMTP_PASSWORD=your-password

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
